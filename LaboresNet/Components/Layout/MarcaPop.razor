@using System;
@using System.Net;
@using System.Text;
@using Microsoft.Maui.ApplicationModel;
@using PortalEmpleadoGeotime.Client.Data.DataBaseLocal

<div class="face-panel">
    <div class="container-canvas">
        <video id="video" autoplay muted playsinline></video>
        <canvas id="overlay"></canvas>
        <div class="face-chip face-chip-@EstadoCss" role="status" aria-live="polite">
            <RadzenIcon Icon="@EstadoIcono" />
            <span>@EstadoTitulo</span>
        </div>
    </div>

    <div class="face-msg face-msg-@EstadoCss">
        <RadzenIcon Icon="@(Estado == EstadoCamara.Error ? "error_outline" : "lightbulb")" />
        <span>@EstadoMensaje</span>
    </div>

    @if (Cameras is not null && Cameras.Count > 1)
    {
        <div class="face-camera-select">
            <RadzenIcon Icon="photo_camera" />
            <RadzenDropDown @bind-Value="SelectedCameraId"
                            Data="@Cameras"
                            TextProperty="Label"
                            ValueProperty="DeviceId"
                            Change="@OnCameraChanged"
                            Style="flex: 1; min-width: 0;" />
        </div>
    }

    @if (Estado == EstadoCamara.Error)
    {
        <RadzenButton Text="Reintentar" Icon="refresh" Click="@Reintentar" Style="width: 100%; margin-top: 0.75rem; background: #017F01;" />
    }
</div>
@* <div class="row">

    <div class="col ml-10">
        <div class="container-canvas">
            <video id="video" autoplay muted></video>
            <canvas id="overlay"></canvas>
        </div>
    </div>
</div> *@
@code {

    [Parameter] public EventCallback<int> OnReconocimiento { get; set; }
    [Parameter] public string? EmpleadoId { get; set; } = null;

    private enum EstadoCamara { Iniciando, Buscando, Comparando, Error }

    private EstadoCamara Estado = EstadoCamara.Iniciando;
    private string? ErrorMensaje;

    private string EstadoCss => Estado.ToString().ToLowerInvariant();

    private string EstadoIcono => Estado switch
    {
        EstadoCamara.Iniciando => "hourglass_top",
        EstadoCamara.Buscando => "face",
        EstadoCamara.Comparando => "sync",
        _ => "videocam_off"
    };

    private string EstadoTitulo => Estado switch
    {
        EstadoCamara.Iniciando => "Iniciando cámara…",
        EstadoCamara.Buscando => "Centra tu rostro en el óvalo",
        EstadoCamara.Comparando => "Procesando rostro…",
        _ => "Cámara no disponible"
    };

    private string EstadoMensaje => Estado switch
    {
        EstadoCamara.Iniciando => "Un momento, estamos preparando la cámara.",
        EstadoCamara.Buscando => "Busca buena iluminación y quítate gorra o lentes oscuros.",
        EstadoCamara.Comparando => "Mantente quieto un momento.",
        _ => ErrorMensaje ?? "No se pudo iniciar la cámara."
    };

    private bool CamaraEncendida = false;
    private List<string> descriptores = new();
    private List<CameraDevice> Cameras = new();
    private string? SelectedCameraId = null;

    private class CameraDevice
    {
        public string DeviceId { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        EmpleadoId = EmpleadoId ?? loginState.Empleado.IdNumero!;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await IniciarFlujoAsync(cargarCamaras: true);
        }
    }

    private async Task IniciarFlujoAsync(bool cargarCamaras)
    {
        try
        {
            Estado = EstadoCamara.Iniciando;
            ErrorMensaje = null;
            StateHasChanged();

            // Cargar lista de cámaras disponibles
            if (cargarCamaras)
                await LoadAvailableCameras();

            await OnIniciarCamara();

            if (!CamaraEncendida)
            {
                Estado = EstadoCamara.Error;
                ErrorMensaje ??= "No se pudo iniciar la cámara. Revisa los permisos de la aplicación e inténtalo de nuevo.";
                StateHasChanged();
                return;
            }

            // Sin permiso previo enumerateDevices no devuelve deviceId; recargar ya con la cámara activa
            if (cargarCamaras && Cameras.Count < 2)
                await LoadAvailableCameras();

            await OnVerificarRostroColaborador();
        }
        catch (Exception e)
        {
            Estado = EstadoCamara.Error;
            ErrorMensaje = "Se presentó un error al iniciar la cámara.";
            StateHasChanged();
            await swal.FireAsync("Atención", $"Se ha presentado un error al iniciar la cámara. Detalle de error: {(e.InnerException == null ? e.Message : e.InnerException)}", SweetAlertIcon.Error);
        }
    }

    private async Task Reintentar()
    {
        await OnApagarCamara();
        await IniciarFlujoAsync(cargarCamaras: false);
    }

    private async Task LoadAvailableCameras()
    {
        try
        {
            // getCameras devuelve un arreglo de objetos {deviceId, label}, no un string JSON
            var cameraList = await JsRuntime.InvokeAsync<List<CameraDevice>>("getCameras");
            cameraList = cameraList?.Where(c => !string.IsNullOrEmpty(c.DeviceId)).ToList();
            if (cameraList is not null && cameraList.Count > 0)
            {
                Cameras = cameraList;
                var savedId = await JsRuntime.InvokeAsync<string?>("loadPreferredCamera");
                SelectedCameraId = !string.IsNullOrEmpty(savedId) && Cameras.Any(c => c.DeviceId == savedId)
                    ? savedId
                    : Cameras[0].DeviceId;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cameras: {ex.Message}");
        }
    }

    private async Task OnCameraChanged(object value)
    {
        if (value is not null && CamaraEncendida)
        {
            try
            {
                // Establecer la cámara preferida
                await JsRuntime.InvokeVoidAsync("setPreferredCamera", SelectedCameraId);
                // Reiniciar la cámara con el nuevo dispositivo
                await OnApagarCamara();
                await Task.Delay(500);
                await OnIniciarCamara();
            }
            catch (Exception ex)
            {
                await swal.FireAsync("Error", $"Error al cambiar la cámara: {ex.Message}", SweetAlertIcon.Error);
            }
        }
    }

    private async Task OnVerificarRostroColaborador()
    {
        Estado = EstadoCamara.Buscando;
        StateHasChanged();
        int caraReconocida = 0;
        try
        {
            var caraDetectada = await JsRuntime.InvokeAsync<int>("verifyFace");

            if (caraDetectada == 1)
            {
                Estado = EstadoCamara.Comparando;
                StateHasChanged();

                IEnumerable<cTemplateFACE> colaboradorFaces = new List<cTemplateFACE>();
                bool sincronizar = await geoConnect.ApiDisponible();

                if (sincronizar)
                    colaboradorFaces = await geoConnect.GetTemplateFACE(EmpleadoId!);
                else
                {
                    MarcasDBLocal laborDBLocal = new();
                    colaboradorFaces = await laborDBLocal.GetTemplateFACEAsync(EmpleadoId!);
                }
                        

                if (colaboradorFaces is not null)
                {
                    descriptores.Clear();
                    foreach (var face in colaboradorFaces)
                    {
                        var descriptor = Encoding.ASCII.GetString(face.FACETEMPLATE);
                        descriptores.Add(descriptor);
                    }

                    if (descriptores.Count() > 0)
                    {
                        // Una sola llamada JS compara contra todas las plantillas
                        caraReconocida = await JsRuntime.InvokeAsync<int>("compareFaceMulti", descriptores, EmpleadoId!);

                        await HideModalRostro(caraReconocida == 1 ? 1 : 0);
                    }
                    else
                    {
                        await HideModalRostro(2);
                    }
                }
                else
                {
                    await HideModalRostro(2);
                }
            }
            else
            {
                await HideModalRostro(0);
            }


        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al procesar el rostro.  Detalle de error: {(e.InnerException == null ? e.Message : e.InnerException)}", SweetAlertIcon.Error);
        }
        StateHasChanged();
    }

    private async Task HideModalRostro(int EsReconocido)
    {
        await OnApagarCamara();
        await OnReconocimiento.InvokeAsync(EsReconocido);
        
    }

    private async Task OnIniciarCamara()
    {
        var camStatus = await Permissions.CheckStatusAsync<Permissions.Camera>();
        if (camStatus != PermissionStatus.Granted)
            camStatus = await Permissions.RequestAsync<Permissions.Camera>();

        var micStatus = await Permissions.CheckStatusAsync<Permissions.Microphone>();
        if (micStatus != PermissionStatus.Granted)
            micStatus = await Permissions.RequestAsync<Permissions.Microphone>();

        if (camStatus != PermissionStatus.Granted || micStatus != PermissionStatus.Granted)
        {
            ErrorMensaje = "No se concedió el permiso de cámara. Actívalo en Ajustes > Apps > Sistema de Labores > Permisos y reintenta.";
            CamaraEncendida = false;
            await swal.FireAsync("Atención", $"No se ha concedido el permiso a esta aplicación para el uso de la cámara.", SweetAlertIcon.Error);
            return;
        }

        // Establecer la cámara preferida si está disponible
        if (!string.IsNullOrEmpty(SelectedCameraId))
        {
            await JsRuntime.InvokeVoidAsync("setPreferredCamera", SelectedCameraId);
        }

        CamaraEncendida = (await JsRuntime.InvokeAsync<int>("startMedia") == 1);
    }

    private async Task OnApagarCamara()
    {
        await JsRuntime.InvokeVoidAsync("stopMedia");

    }
}

