@inherits LayoutComponentBase
@using Microsoft.Extensions.Configuration
@using PortalEmpleadoGeotime.Client.Data.DataBaseLocal

<RadzenComponents />

<RadzenLayout style="grid-template-rows: auto 1fr auto;">
    <RadzenHeader>
        <div class="header-content">
            <div class="header-left">                
                <img src="@strIcon" alt="Softland" style="height: 30px; width: auto;" />
                             
            </div>
            <div class="header-center">
                <RadzenText TextStyle="TextStyle.H6" Style="color: white; margin: 0; font-weight: bold;">Sistema de Labores</RadzenText>
            </div>
            <div class="header-right">                
                <RadzenButton Icon="logout" Click="@CerrarSesion" Variant="Variant.Text" Style="color: white;" />
            </div>
        </div>
    </RadzenHeader>

    <RadzenBody>
        <div class="rz-p-1">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <div class="footer-content">
            <ApiSemaforo GeoTimeOk="@geoTimeOk" />
        </div>
    </RadzenFooter>

</RadzenLayout>

@code {

    string strIcon = "";

    private bool Desconectado = false;

    // Estado de las APIs para el semáforo del footer (se consulta una sola vez al cargar)
    private bool? geoTimeOk;
    MarcasDBLocal marcasDBLocal = new();


    protected override async Task OnInitializedAsync()
    {
        strIcon = "./img/LogoSoftlandCA_blanco.png";

        if (loginState.Empleado is null)
        {
            NavigationManager.NavigateTo("./");
            return;
        }

        if (String.IsNullOrEmpty(loginState.Empleado.IdNumero))
        {
            NavigationManager.NavigateTo("./");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                /* Validar disponibilidad de la API de Geotime (una sola vez) */
                geoTimeOk    = await geoConnect.ApiDisponible();
                Desconectado = geoTimeOk != true;
                StateHasChanged();

                cPortal_Config? portal_Config = null;
                if (!Desconectado)
                {
                    portal_Config = await geoConnect.GetPortalConfig();
                }
                else
                {
                    portal_Config = await marcasDBLocal.GetPortalConfigAsync();
                }
                if (portal_Config is not null)
                {
                    if (portal_Config!.USARECONOCIMIENTOFACIAL)
                    {
                        await JsRuntime.InvokeAsync<bool>("idbSet", "distancia", portal_Config.FACEDIST);
                        await JsRuntime.InvokeAsync<bool>("idbSet", "textura", portal_Config.FACETEXT);
                    }
                }
                
            }
            catch (Exception e)
            {
                Console.WriteLine(e.Message);
            }



        }
    }

    private void CerrarSesion() => NavigationManager.NavigateTo("./index");

    private void IrAInicio() => NavigationManager.NavigateTo("./principal");


}


<style>
    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
        padding: 0 1rem;
        background: linear-gradient(90deg, #1AA5EA 0%, #2192FF 60%, #265AE8 100%); /* Degradado de marca Geotime */
    }

    .header-left {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        flex: 1;
    }

    .header-center {
        flex: 2;
        text-align: center;
    }

    .header-right {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
    }

    /* Sobrescribir estilos de Radzen para el header */
    .rz-header {
        background: linear-gradient(90deg, #1AA5EA 0%, #2192FF 60%, #265AE8 100%) !important;
    }

    /* Footer */
    .rz-footer {
        background: linear-gradient(90deg, #052767, #1a76cb) !important;
        padding: 0 !important;
    }

    .footer-content {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 0.5rem;
        padding: 4px 0.5rem;
        background: linear-gradient(90deg, #052767, #1a76cb);
    }

    .footer-field {
        display: flex;
        align-items: center;
        flex: 1 1 0;
        min-width: 0;
    }

    .footer-field label {
        white-space: nowrap;
    }

</style>