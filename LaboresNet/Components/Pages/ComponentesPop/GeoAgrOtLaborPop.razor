<RadzenDataGrid TItem="GeoAgrOtLabor" Data="@otLabores"
                AllowFiltering="true" AllowPaging="true" PageSize="10"
                AllowSorting="true" FilterMode="FilterMode.SimpleWithMenu"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                RowClick="@OnSelect"
                Style="width:100%;">
    <Columns>
        <RadzenDataGridColumn TItem="GeoAgrOtLabor" Property="NombreLabor" Title="Labor">
            <Template Context="item">
                <div style="display:flex;gap:8px;align-items:flex-start;padding:2px 0;">
                    <div class="emp-avatar" style="width:36px;height:36px;font-size:0.85rem;flex-shrink:0;">
                        @(string.IsNullOrEmpty(item.NombreLabor) ? "?" : item.NombreLabor.Substring(0, 1).ToUpper())
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:600;font-size:0.85rem;color:#212121;line-height:1.3;">@item.NombreLabor</div>                        
                        @if (!string.IsNullOrEmpty(item.Labor))
                        {
                            <div class="emp-meta-row">
                                <RadzenIcon Icon="work" Style="font-size:0.78rem;color:#bbb;flex-shrink:0;" />
                                @item.Labor
                            </div>
                        }
                    </div>
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public EventCallback<GeoAgrOtLabor> OnGeoAgrOtLaborSelected { get; set; }
    [Parameter] public IEnumerable<GeoAgrOtLabor>? otLabores { get; set; }

    void OnSelect(DataGridRowMouseEventArgs<GeoAgrOtLabor> args)
    {
        OnGeoAgrOtLaborSelected.InvokeAsync(args.Data);
    }
}
