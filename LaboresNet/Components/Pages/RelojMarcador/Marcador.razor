@page "/marcador"
@layout RecFaceLayout

@implements IDisposable
@inject SweetAlertService swal;
@inject IGeoTimeConnect geoConnect
@inject IBrowserService browserService




<RadzenStack Orientation="@Radzen.Orientation.Vertical" Gap="10px" Reverse="false" JustifyContent="Radzen.JustifyContent.Center" AlignItems="Radzen.AlignItems.Center" Wrap="FlexWrap.NoWrap" Style="height: 400px">
    <RadzenRow Gap="1rem" class="rz-text-align-center">
        <RadzenColumn class="rz-text-align-center" Size="12">
            <RadzenText TextStyle="TextStyle.H3">Seleccione la Compañia</RadzenText>
        </RadzenColumn>
    </RadzenRow>
    @if (InProcess)
    {
        <SpinnerControl></SpinnerControl>
    }
    <RadzenRow Gap="1rem" class="rz-text-align-center">
        @foreach (var company in companias)
        {
            <RadzenColumn>
                <div class="card shadow mb-1 text-center h-100 bi-blue" style="width: @cardSize;max-width: @cardSize;">
                    <a class="nav-lnk" @onclick="() => SeleccionarCompania(company.IDCOMP)">
                        <svg xmlns="http://www.w3.org/2000/svg" height="@svgSize" width="@svgSize" viewBox="0 0 24 24" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" class="bi d-block mx-auto mb-1 feather feather-settings">
                            <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" />
                        </svg>
                        <span style="font-size:@fontSize;color:darkblue">@company.COMPANIA</span>
                    </a>
                </div>
            </RadzenColumn>
        }
    </RadzenRow>
    
        
</RadzenStack>

@code {
    IEnumerable<cPh_Compania> companias = new List<cPh_Compania>();
    BrowserDimension windowdimensions = new();
    string cardSize = "15rem";
    string svgSize = "150px";
    string fontSize = "large";
    private bool InProcess = true;

    protected override async Task OnInitializedAsync()
    {
        loginState.OnChange += StateHasChanged;
        geoConnect.OnChange += StateHasChanged;

        companias = await geoConnect.GetPhCompania();
        InProcess = false;

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            windowdimensions = await browserService.GetDimensions();
            if (windowdimensions.Width == 0 || windowdimensions.Width > 550)
            {
                cardSize = "15rem";
                svgSize = "150px";
                fontSize = "large";
            }
            else
            {
                cardSize = "10rem";
                svgSize = "90px";
                fontSize = "x-small";
            }
            await this.InvokeAsync(() => this.StateHasChanged());

        }

    }


    private async Task SeleccionarCompania(string idcomp)
    {

        InProcess = true;
        StateHasChanged();
        try
        {
            var companiaSeleccionada = companias.FirstOrDefault(e => e.IDCOMP == idcomp);

            geoConnect.setSchema(companiaSeleccionada!);
            loginState.SetCompaniaTenant(companiaSeleccionada!.IDCOMP);
            loginState.SetMarcador(true);
            loginState.SetTimeZone(companiaSeleccionada!.ZONAHORARIA);
            Thread.Sleep(1000);


            var portal_Config = await geoConnect.GetPortalConfig();

            if (portal_Config!.USARECONOCIMIENTOFACIAL)
            {
                await JsRuntime.InvokeAsync<bool>("idbSet", "distancia", portal_Config.FACEDIST);
                await JsRuntime.InvokeAsync<bool>("idbSet", "textura", portal_Config.FACETEXT);
            }

			
            NavigationManager.NavigateTo("./registromarcas");

           
        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al seleccionar la compañía.  Detalle de error: {e.Message}", SweetAlertIcon.Info);
            InProcess = false;
        }
        
    }

    public void Dispose()
    {
        loginState.OnChange -= StateHasChanged;
        geoConnect.OnChange -= StateHasChanged;
    }


}
