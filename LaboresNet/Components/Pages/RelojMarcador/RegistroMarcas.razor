@page "/registromarcas"
@using System.Text
@using System.Text.Json
@layout RecFaceLayout

@inject IJSRuntime JSRuntime
@inject SweetAlertService swal;
@inject IGeoTimeConnect geoConnect
@inject IBrowserService browserService
@inject NavigationManager NavigationManager

<div class="card">
    <PageReturn Titulo="Registro de Marcas" UrlRetorno="./Marcador"></PageReturn>
    <div class="ibm-plex-serif-bold">
          <RadzenPanel AllowCollapse="true" class="panel-brand" Style="margin-bottom:0.5rem;">
            <HeaderTemplate>
                <span @onclick="VerFaceLogs" @onclick:stopPropagation="true" style="cursor:pointer;">
                    <RadzenIcon Icon="person" class="me-1" />
                </span> Por favor seleccione el tipo de marca y acerque su rostro a la pantalla
            </HeaderTemplate>
            <ChildContent>
                @if (InProcess)
                {
                    <SpinnerControl></SpinnerControl>
                }
                @if (showCameraSelector)
                {
                    <div class="d-flex align-items-center gap-2 mb-2 px-1">
                        <RadzenIcon Icon="videocam" Style="flex-shrink:0;" />
                        <RadzenDropDown @bind-Value="selectedCameraId"
                                        Data="@cameras"
                                        TextProperty="Label"
                                        ValueProperty="DeviceId"
                                        Style="flex:1; font-size:small;"
                                        Change="@OnCameraChanged" />
                    </div>
                }
                <br />
                <div class="row mt-100">
                    <div class="col mb-3 d-flex flex-col justify-content-center">
                        <div class="card shadow mb-1 text-center h-100 bi-green" style="width: @cardSize;max-width: @cardSize;">
                            <button class="nav-lnk" @onclick="() => RegistrarMarca(1)">
                                <svg xmlns="http://www.w3.org/2000/svg" height="@svgSize" width="@svgSize" viewBox="0 0 24 24" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" class="bi d-block mx-auto mb-1 feather feather-settings">
                                    <path d="M11,7L9.6,8.4l2.6,2.6H2v2h10.2l-2.6,2.6L11,17l5-5L11,7z M20,19h-8v2h8c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2h-8v2h8V19z" />
                                </svg>
                                <span style="font-size:@fontSize;color:green">Entrada</span>
                            </button>
                        </div>
                    </div>
                    <div class="col mb-3 d-flex flex-col justify-content-center">
                        <div class="card shadow mb-1 text-center h-100 bi-orange" style="width: @cardSize;max-width: @cardSize;">
                            <button class="nav-lnk" @onclick="() => RegistrarMarca(3)">
                                <svg xmlns="http://www.w3.org/2000/svg" height="@svgSize" width="@svgSize" viewBox="0 0 24 24" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" class="bi d-block mx-auto mb-1 feather feather-settings">
                                    <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" />
                                </svg>
                                <span style="font-size:@fontSize;color:green">Descanso</span>
                            </button>
                        </div>
                    </div>
                    <div class="col mb-3 d-flex flex-col justify-content-center">
                        <div class="card shadow mb-1 text-center h-100 bi-red" style="width: @cardSize;max-width: @cardSize;">
                            <button class="nav-lnk" @onclick="() => RegistrarMarca(2)">
                                <svg xmlns="http://www.w3.org/2000/svg" height="@svgSize" width="@svgSize" viewBox="0 0 24 24" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round" class="bi d-block mx-auto mb-1 feather feather-settings">
                                    <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                                </svg>
                                <span style="font-size:@fontSize;color:green">Salida</span>
                            </button>
                        </div>
                    </div>
                </div>

            </ChildContent>
        </RadzenPanel>
        @if (portal_Config!.VERLOGMARCAS)
        {
            <RadzenPanel AllowCollapse="true" class="panel-brand" Style="margin-bottom:0.5rem;">
                <HeaderTemplate>
                    <RadzenIcon Icon="history" class="me-1" /> Historial de marca
                </HeaderTemplate>
                <ChildContent>
                    <div class="row">
                        <div class="col-12 w-100">
                            <RadzenListBox @bind-Value=@value Data=@receiveData Style="width: 100%; height:200px" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "select company" } })" />
                        </div>
                    </div>
                </ChildContent>
            </RadzenPanel>

        }
    </div>
</div>





    

    


@code {

    private bool InProcess = true;
    private string? dirIp = "";
    private int TipoMarcaGlobal = 0;

    private List<string> descriptores = new();

    // Camera selection
    public class CameraInfo
    {
        [System.Text.Json.Serialization.JsonPropertyName("deviceId")]
        public string DeviceId { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("label")]
        public string Label { get; set; } = "";
    }
    private List<CameraInfo> cameras = new();
    private string selectedCameraId = "";
    private bool showCameraSelector = false;
    //private bool CamaraEncendida = false;
    private IEnumerable<cEmpleado> empleados = new List<cEmpleado>();
    private IEnumerable<cTemplateFACE> colaboradorFaces = new List<cTemplateFACE>();
    string cardSize = "15rem";
    string svgSize = "150px";
    string fontSize = "large";
    BrowserDimension windowdimensions = new();
    List<string> receiveData = new();
    private string value = "";
    private string idColaborador = "";
    double latitud = 0;
    double longitud = 0;


    // private DotNetObjectReference<RegistroMarcas>? dotNetHelper;

    public class MarcaExt : cMarca
    {
        public DateOnly FechaMarca { get; set; }
        public string TipoMarca { get; set; }
    }

    cPortal_Config? portal_Config = new cPortal_Config
    {
        USARECONOCIMIENTOFACIAL = false,
        USARGEOLOCALIZACION = false,
        VERLOGMARCAS = false,
    };

    protected override async Task OnInitializedAsync()
    {

        try
        {

            empleados = await geoConnect.GetEmpleado();
            colaboradorFaces = await geoConnect.GetTemplateFACE();
            using (HttpClient client = new HttpClient())
            {
                var uri = new Uri("https://ipinfo.io/ip");
                HttpResponseMessage response = await client.GetAsync(uri);
                if (response.IsSuccessStatusCode)
                {
                    var data = await response.Content.ReadAsStringAsync();
                    dirIp = data.ToString();
                }
            }



        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", $"Error al cargar Registro de Marcas - Dirección del cliente.  Detalle de error: {e.Message}", SweetAlertIcon.Info);
        }
        InProcess = false;
        StateHasChanged();

    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (!loginState.InMarcador)
                {
                    NavigationManager.NavigateTo("./Marcador");
                    return;
                }

                portal_Config = await geoConnect.GetPortalConfig();

                // Cargar lista de cámaras disponibles
                var camList = await JSRuntime.InvokeAsync<List<CameraInfo>>("getCameras");
                if (camList is not null && camList.Count > 1)
                {
                    cameras = camList;
                    var savedId = await JSRuntime.InvokeAsync<string?>("loadPreferredCamera");
                    if (!string.IsNullOrEmpty(savedId) && cameras.Any(c => c.DeviceId == savedId))
                        selectedCameraId = savedId;
                    else
                    {
                        selectedCameraId = cameras[0].DeviceId;
                        await JSRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
                    }
                    showCameraSelector = true;
                    StateHasChanged();
                }

                if (portal_Config!.USARGEOLOCALIZACION)
                {

                    var coordenadasGPS = await GetLocationAsync();

                    if (coordenadasGPS is not null)
                    {
                        latitud = coordenadasGPS.Latitude;
                        longitud = coordenadasGPS.Longitude;
                    }
                   

                    StateHasChanged();
                }

                windowdimensions = await browserService.GetDimensions();
                if (windowdimensions.Width == 0 || windowdimensions.Width > 550)
                {
                    cardSize = "15rem";
                    svgSize = "150px";
                    fontSize = "large";
                }
                else
                {
                    cardSize = "12rem";
                    svgSize = "120px";
                    fontSize = "small";
                }

                var paramDistancia = await JSRuntime.InvokeAsync<decimal>("idbGet", "distancia");
                var paramTextura = await JSRuntime.InvokeAsync<decimal>("idbGet", "textura");

                
                if (paramDistancia == 0 || paramTextura == 0)
                {
                    NavigationManager.NavigateTo("./Marcador");
                    return;
                }
                    
                
                

                InProcess = false;
                await this.InvokeAsync(() => this.StateHasChanged());

                // dotNetHelper = DotNetObjectReference.Create(this);
                // // Pass the .NET object reference to JavaScript
                // await JSRuntime.InvokeVoidAsync("registerDotNetHelper", dotNetHelper);

            }
            catch (Exception e)
            {
                await swal.FireAsync("Error", $"Error al cargar la pagina.  Detalle de error: {e.Message}", SweetAlertIcon.Info);
            }

        }
    }


    private async void RegistrarMarca(int tipoMarca)
    {
        try
        {
            value = "";
            receiveData = new List<string>();
            StateHasChanged();
            if (portal_Config!.USARECONOCIMIENTOFACIAL)
            {
                TipoMarcaGlobal = tipoMarca;

                await SolicitarCodigoEmpleado();

            }
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", $"Error guardar el registro de marca. Detalle de error: {e.Message}", SweetAlertIcon.Error);
        }

    }

    private TimeZoneInfo GetTimeZoneByOffset(int offsetHours)
    {
        var allZones = TimeZoneInfo.GetSystemTimeZones();
        return allZones.FirstOrDefault(z => z.BaseUtcOffset.Hours == offsetHours);
    }

    private async Task GuardarMarca(int tipoMarca, string idnumero)
    {
        List<cMarcaIn> listMarcaIn = new();
        

        var tz = GetTimeZoneByOffset(loginState.TimeZone);

        string zonaHorariaSeleccionada = tz.Id;
        string horaMarcaZH = "";
        if (!string.IsNullOrEmpty(zonaHorariaSeleccionada))
        {
            var utcNow = DateTime.UtcNow;
            var zona = TimeZoneInfo.FindSystemTimeZoneById(zonaHorariaSeleccionada);
            var horaLocal = TimeZoneInfo.ConvertTimeFromUtc(utcNow, zona);
            horaMarcaZH = horaLocal.ToString("HH:mm");
        }
        else
        {
            horaMarcaZH = DateTime.Now.ToString("HH:mm");
        }

        var empleado = empleados.FirstOrDefault(e => e.IdNumero == idnumero);

        if (empleado == null)
        {
            await swal.FireAsync("Error", "No se encontró el número de empleado cuyo rostro fue detectado.", SweetAlertIcon.Error);
            return;
        }

        cMarcaIn marcaIn = new cMarcaIn
        {
            idtarjeta = empleado!.Tarjeta,
            fecha = DateTime.Parse(DateTime.Now.ToString("yyyy-MM-dd")),
            hora = horaMarcaZH,
            idterminal = "WPE",
            tipo = tipoMarca,
            idplanilla = empleado.IdPlanilla,
            idnumero = empleado.IdNumero,
            estado = 'N',
            fecha_reg = DateTime.Now,
            long_reg = longitud.ToString(),
            lat_reg = latitud.ToString(),
            imagen_reg = null,
            gps_cell = null,
            host = dirIp,
            dir_ip = dirIp,
        };
        listMarcaIn.Add(marcaIn);

        var respuesta = await geoConnect.Post("MarcaIn", listMarcaIn);
        if (respuesta.Id == "0")
        {
            await swal.FireAsync($"¡Felicidades, {empleado.Nombre}!", $"Su marca de {Utiles.GetTipoMarca(tipoMarca)} se realizó con exito", SweetAlertIcon.Success);
        }
        else
        {
            await swal.FireAsync("Error", respuesta.Descripcion, SweetAlertIcon.Error);
        }
    }

    private async Task IniciarReconocimiento()
    {
        var empleadoSeleccionado = empleados.FirstOrDefault(e => e.IdNumero == idColaborador);
              

        if (empleadoSeleccionado == null)
        {
            await swal.FireAsync("Error", "No se encontró el número de empleado que ingresó.", SweetAlertIcon.Error);
            return;
		}
        var faces = colaboradorFaces.Where(e => e.IDNUMERO == idColaborador);

        if (faces is not null && faces.Count()>0)
        {
            loginState.Empleado = empleadoSeleccionado;
            await dialogService.OpenAsync<MarcaRelojPop>("Reconociendo",
            new Dictionary<string, object>()
              {
                    { "OnReconocimiento", EventCallback.Factory.Create<ParamReloj>(this, HideModalRostro) },
                    { "colaboradorFaces", faces },
                    { "empleados", empleados }

              },
            new DialogOptions()
            {
                Resizable = false,
                Draggable = false,
                Width = "310px",
                Height = "400px",
            });
        }
        else
        {
            await swal.FireAsync("Error", "No se ha encontrado rostros asociados al Id de colaborador que se indicó.", SweetAlertIcon.Error);
        }


    }

    private async Task HideModalRostro(ParamReloj paramReloj)
    {
        dialogService.Close(true);
        switch (paramReloj.EsReconocido)
        {
            case 0:
                await swal.FireAsync("Error", "No fue posible reconocer su rostro. La marca no se ha realizado.  Intente nuevamente acercando su rostro más hacia la cámara.", SweetAlertIcon.Error);
                await MostrarLog();
                break;
            case 1:
                await GuardarMarca(TipoMarcaGlobal, paramReloj.IdNumero!);
                break;
            case 2:
                await swal.FireAsync("Error", "Su rostro no ha sido registrado en la base de datos. Por favor contacte al administrador.", SweetAlertIcon.Error);
                await MostrarLog();
                break;
        }

    }


    private async Task SolicitarCodigoEmpleado()
    {

        await dialogService.OpenAsync<TecladoNumerico>("Ingrese su Id de Colaborador",
             new Dictionary<string, object>()
               {
                    { "OnAccept", EventCallback.Factory.Create<string>(this, HideTecladoNumerico) }

               },
             new DialogOptions()
             {
                 Resizable = false,
                 Draggable = false,
                 Width = "500px",
                 Height = "500px",
             });

    }

    private async Task HideTecladoNumerico(string args)
    {
        dialogService.Close(true);        
        idColaborador = args;

        if (string.IsNullOrEmpty(idColaborador))
        {
            await swal.FireAsync("Error", "Debe ingresar su Id de Colaborador para continuar con el reconocimiento facial.", SweetAlertIcon.Error);
            return;
        }
        await IniciarReconocimiento();
    }

    public class MensajeLS
    {
        public string? ts { get; set; }
        public string? msg {get; set; }
    }

    private async Task OnCameraChanged(object value)
    {
        selectedCameraId = value?.ToString() ?? "";
        await JSRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
    }

    private async Task MostrarLog()
    {
        try
        {
            
            var logs = await JSRuntime.InvokeAsync<List<MensajeLS>>("idbGet", "faceLogs");

            if (logs is null)
            {
                receiveData = new List<string>();
            }
            else
            {
                receiveData = logs.Select(l => {
                    var ts = string.Empty;
                    if (!string.IsNullOrEmpty(l.ts))
                    {
                        try
                        {
                            ts = DateTime.Parse(l.ts).ToString("yyyy-MM-dd HH:mm:ss");
                        }
                        catch
                        {
                            ts = l.ts!;
                        }
                    }
                    return string.IsNullOrEmpty(ts) ? (l.msg ?? string.Empty) : ($"{ts} - {l.msg}");
                }).ToList();
            }

            StateHasChanged();
        }
        catch (Exception e)
        {
            await swal.FireAsync("Error", $"Error al leer logs: {e.Message}", SweetAlertIcon.Error);
        }

    }

    private async Task<Location?> GetLocationAsync()
    {
        var status = await Permissions.CheckStatusAsync<Permissions.LocationWhenInUse>();
        if (status != PermissionStatus.Granted)
            status = await Permissions.RequestAsync<Permissions.LocationWhenInUse>();

        if (status != PermissionStatus.Granted)
            return null; // permiso denegado

        try
        {
            var request = new GeolocationRequest(GeolocationAccuracy.Best, TimeSpan.FromSeconds(10));
            var location = await Geolocation.Default.GetLocationAsync(request);
            return location;
        }
        catch (Exception ex)
        {
            // manejar Timeouts, falta de GPS, etc.
            Console.WriteLine(ex.Message);
            return null;
        }
    }

    private async Task VerFaceLogs()
    {
        await dialogService.OpenAsync<FaceLogsPop>("Historial de Reconocimientos",
             new Dictionary<string, object>(),
             new DialogOptions()
             {
                 Resizable = true,
                 Draggable = true,
                 Width = "700px",
                 Height = "500px",
             });
    }

