@page "/enrolarempleado/{idNumero}"
@using System.Text
@using System.Text.Json.Serialization
@implements IAsyncDisposable

@* Enrolamiento guiado: una sola sesión de cámara con captura automática por pose (face-enroll.js).
   El flujo anterior (5 plantillas, una por una) sigue disponible en EnrolarEmpleadoAnterior.razor. *@

<div class="card">
    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />
    <div class="card-body px-2 enr">

        <div class="enr-cabecera">
            <div class="enr-nombre">@(empleado?.Nombre ?? "Colaborador") · ID @idNumero</div>
            <div class="enr-guardadas">@existentes guardadas</div>
        </div>

        @if (cargando)
        {
            <div class="text-center enr-cargando">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" Style="height:4px;" />
                Preparando el enrolamiento…
            </div>
        }
        else if (errorCarga is not null)
        {
            <div class="enr-alerta enr-alerta-error" role="alert"><RadzenIcon Icon="error_outline" />@errorCarga</div>
        }
        else if (total <= 0)
        {
            <div class="enr-alerta enr-alerta-aviso" role="status">
                <RadzenIcon Icon="info" />El colaborador ya tiene la cantidad máxima de plantillas permitida (@maxPlantillas).
            </div>
        }
        else
        {
            <div class="enr-video enr-estado-@estadoTipo">
                <video id="video" autoplay muted playsinline></video>
                @if (Completo)
                {
                    <div class="enr-completo">
                        <RadzenIcon Icon="check_circle" />
                        <div class="enr-completo-titulo">@capturadas plantillas capturadas</div>
                        <div class="enr-completo-detalle">Variadas y de la misma persona</div>
                    </div>
                }
                else
                {
                    <div class="enr-ovalo"></div>
                    <div class="enr-chip"><RadzenIcon Icon="fiber_manual_record" />Auto</div>
                    @if (progresoSostener > 0)
                    {
                        <div class="enr-sostener"><div style="width:@(Math.Round(progresoSostener * 100))%"></div></div>
                    }
                    <div class="enr-pose">
                        <RadzenIcon Icon="@Pose.Icono" />
                        <div>
                            <div class="enr-pose-num">Plantilla @(capturadas + 1) de @total</div>
                            <div class="enr-pose-texto">@Pose.Texto</div>
                        </div>
                    </div>
                }
            </div>

            <div class="enr-puntos" aria-label="@($"{capturadas} de {total} plantillas capturadas")">
                @for (int i = 0; i < total; i++)
                {
                    var hecho = i < capturadas;
                    var actual = i == capturadas;
                    <div class="enr-punto @(hecho ? "hecho" : actual ? "actual" : "")">
                        @if (hecho)
                        {
                            <RadzenIcon Icon="check" />
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </div>
                }
            </div>

            @if (!Completo && !string.IsNullOrEmpty(estadoMensaje))
            {
                <div class="enr-mensaje enr-mensaje-@estadoTipo" role="status" aria-live="polite">
                    <RadzenIcon Icon="@IconoEstado" />@estadoMensaje
                </div>
            }

            @if (parecidos.Count > 0)
            {
                <div class="enr-alerta enr-alerta-error" role="alert">
                    <RadzenIcon Icon="group" />
                    Este rostro se parece al de @(string.Join(", ", parecidos.Select(p => $"ID {p.IdNumero}"))). Verifique antes de guardar.
                </div>
            }

            @if (showCameraSelector)
            {
                <div class="d-flex align-items-center gap-2 mt-2 px-1">
                    <RadzenIcon Icon="videocam" Style="flex-shrink:0;" />
                    <RadzenDropDown @bind-Value="selectedCameraId" Data="@cameras" TextProperty="Label" ValueProperty="DeviceId"
                                    Style="flex:1; font-size:small;" Change="@OnCameraChanged" />
                </div>
            }

            <div class="enr-acciones">
                @if (capturadas >= minimoGuardar)
                {
                    <RadzenButton Icon="save" Text="@($"Guardar {capturadas} {(capturadas == 1 ? "plantilla" : "plantillas")}")"
                                  ButtonStyle="ButtonStyle.Success" Size="Radzen.ButtonSize.Large" Disabled="@guardando"
                                  Style="width:100%;touch-action:manipulation;" Click="@OnGuardar" />
                }
                @if (!Completo)
                {
                    <RadzenButton Icon="photo_camera" Text="Capturar plantilla manual" ButtonStyle="ButtonStyle.Light"
                                  Size="Radzen.ButtonSize.Large" Disabled="@(!camaraLista)"
                                  Style="width:100%;touch-action:manipulation;" Click="@OnManual" />
                }
                @if (capturadas > 0)
                {
                    <RadzenButton Icon="refresh" Text="Repetir" ButtonStyle="ButtonStyle.Light" Size="Radzen.ButtonSize.Large"
                                  Disabled="@guardando" Style="width:100%;touch-action:manipulation;" Click="@OnRepetir" />
                }
                <RadzenButton Icon="close" Text="Cancelar" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                              Size="Radzen.ButtonSize.Large" Style="width:100%;touch-action:manipulation;"
                              Click="@(() => NavigationManager.NavigateTo(UrlRetorno))" />
            </div>

            @if (!Completo && minimoGuardar > capturadas)
            {
                <div class="enr-nota">Para guardar se necesitan las @minimoGuardar plantillas.</div>
            }
        }

        <div class="enr-anterior">
            <a href="@($"./enrolarempleado-anterior/{idNumero}")">Usar el registro anterior, una plantilla a la vez</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public string idNumero { get; set; } = "";

    private const string UrlRetorno = "./empleadoextlist";
    private const string Titulo = "Registro de Rostros de Colaboradores";
    private const int MaxPorDefecto = 10;

    private record PoseGuia(string Texto, string Icono);

    // Mismo orden que ENROLL_POSES en face-enroll.js. Los giros e inclinaciones se piden "hacia un lado"
    // y luego "hacia el otro", porque la dirección que entrega cada cámara no es confiable.
    private static readonly PoseGuia[] Poses =
    {
        new("De frente, expresión neutral", "face"),
        new("De frente, con una sonrisa leve", "sentiment_satisfied"),
        new("Gire levemente la cabeza hacia un lado", "rotate_left"),
        new("Ahora gírela levemente hacia el otro lado", "rotate_right"),
        new("Levante o baje un poco la barbilla", "swap_vert"),
        new("Ahora inclínela hacia el lado contrario", "swap_vert"),
        new("De frente, un paso más lejos de la cámara", "zoom_out"),
        new("De frente, un poco más cerca de la cámara", "zoom_in"),
        new("Con lentes, si los usa (si no, de frente)", "visibility"),
        new("De frente, con otra luz (cerca de una ventana u otra lámpara)", "wb_sunny"),
    };

    public class Parecido
    {
        [JsonPropertyName("idnumero")] public string IdNumero { get; set; } = "";
        [JsonPropertyName("distancia")] public double Distancia { get; set; }
    }

    private class InicioEnrolamiento
    {
        [JsonPropertyName("ok")] public bool Ok { get; set; }
        [JsonPropertyName("motivo")] public string? Motivo { get; set; }
    }

    public class CameraInfo
    {
        [JsonPropertyName("deviceId")] public string DeviceId { get; set; } = "";
        [JsonPropertyName("label")] public string Label { get; set; } = "";
    }

    private cEmpleado? empleado;
    private bool cargando = true;
    private string? errorCarga;
    private int maxPlantillas;
    private int existentes;
    private int total;
    private int poseInicial;
    private int minimoGuardar;
    private List<string> descriptoresExistentes = new();
    private object[] otros = Array.Empty<object>();

    private bool iniciado;
    private bool camaraLista;
    private bool guardando;
    private int capturadas;
    private string estadoTipo = "buscando";
    private string estadoMensaje = "";
    private double progresoSostener;
    private List<Parecido> parecidos = new();
    private DotNetObjectReference<EnrolarEmpleado>? referencia;

    private List<CameraInfo> cameras = new();
    private string selectedCameraId = "";
    private bool showCameraSelector;

    private bool Completo => total > 0 && capturadas >= total;
    private PoseGuia Pose => Poses[(poseInicial + capturadas) % Poses.Length];

    private string IconoEstado => estadoTipo switch
    {
        "sosteniendo" => "check_circle",
        "aviso" => "warning",
        "error" => "error_outline",
        _ => "lightbulb"
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(loginState.Empleado?.IdNumero))
        {
            NavigationManager.NavigateTo("./");
            return;
        }

        try
        {
            empleado = await geoConnect.GetEmpleado(idNumero);
            var portal = await geoConnect.GetPortalConfig();
            maxPlantillas = portal?.CANTMAXPLANTILLAS > 0 ? portal.CANTMAXPLANTILLAS : MaxPorDefecto;

            var todas = (await geoConnect.GetTemplateFACE()).ToList();
            descriptoresExistentes = todas.Where(t => t.IDNUMERO == idNumero)
                .Select(t => Encoding.ASCII.GetString(t.FACETEMPLATE)).ToList();
            otros = todas.Where(t => t.IDNUMERO != idNumero)
                .GroupBy(t => t.IDNUMERO)
                .Select(g => (object)new { idnumero = g.Key, descriptores = g.Select(t => Encoding.ASCII.GetString(t.FACETEMPLATE)).ToList() })
                .ToArray();

            existentes = descriptoresExistentes.Count;
            total = maxPlantillas - existentes;
            poseInicial = existentes % Poses.Length;
            // Un colaborador nuevo debe completar todas las fotos; si ya tiene, puede agregar desde una
            minimoGuardar = existentes == 0 ? total : 1;
        }
        catch (Exception e)
        {
            errorCarga = $"No se pudo cargar la información del colaborador. Detalle: {e.Message}";
        }
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El video existe en el DOM solo después de cargar los datos
        if (iniciado || cargando || errorCarga is not null || total <= 0) return;
        iniciado = true;
        await IniciarAsync();
    }

    private async Task IniciarAsync()
    {
        try
        {
            var permiso = await Permissions.CheckStatusAsync<Permissions.Camera>();
            if (permiso != PermissionStatus.Granted) permiso = await Permissions.RequestAsync<Permissions.Camera>();
            if (permiso != PermissionStatus.Granted)
            {
                MostrarEstado("error", "No se ha concedido el permiso para usar la cámara.");
                return;
            }

            await CargarCamarasAsync();

            referencia = DotNetObjectReference.Create(this);
            var inicio = await JsRuntime.InvokeAsync<InicioEnrolamiento>("enrollStart", referencia, new
            {
                total,
                poseInicial,
                existentes = descriptoresExistentes,
                otros
            });
            camaraLista = inicio.Ok;
            if (!inicio.Ok) MostrarEstado("error", inicio.Motivo ?? "No se pudo iniciar el enrolamiento.");
            else MostrarEstado("buscando", "Ubique el rostro dentro del óvalo");
        }
        catch (Exception e)
        {
            MostrarEstado("error", "Se presentó un error al iniciar la cámara.");
            await swal.FireAsync("Atención", $"No se pudo iniciar el enrolamiento. Detalle de error: {e.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task CargarCamarasAsync()
    {
        var lista = await JsRuntime.InvokeAsync<List<CameraInfo>>("getCameras");
        if (lista is null || lista.Count <= 1) return;
        cameras = lista;
        var guardada = await JsRuntime.InvokeAsync<string?>("loadPreferredCamera");
        selectedCameraId = !string.IsNullOrEmpty(guardada) && cameras.Any(c => c.DeviceId == guardada) ? guardada : cameras[0].DeviceId;
        await JsRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
        showCameraSelector = true;
    }

    private async Task OnCameraChanged(object value)
    {
        selectedCameraId = value?.ToString() ?? "";
        await JsRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
        // Reinicia solo la cámara; las fotos ya capturadas se conservan en face-enroll.js
        await JsRuntime.InvokeVoidAsync("stopMedia");
        await JsRuntime.InvokeAsync<int>("startCamera");
    }

    [JSInvokable]
    public Task OnEstado(string tipo, string mensaje, double progreso)
    {
        estadoTipo = tipo;
        estadoMensaje = mensaje;
        progresoSostener = progreso;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnCaptura(int cantidad, List<Parecido> lista)
    {
        capturadas = cantidad;
        parecidos = lista ?? new();
        progresoSostener = 0;
        estadoMensaje = "";
        return InvokeAsync(StateHasChanged);
    }

    private void MostrarEstado(string tipo, string mensaje)
    {
        estadoTipo = tipo;
        estadoMensaje = mensaje;
        StateHasChanged();
    }

    private async Task OnManual() => await JsRuntime.InvokeVoidAsync("enrollManual");

    private async Task OnRepetir()
    {
        await JsRuntime.InvokeVoidAsync("enrollReiniciar");
        capturadas = 0;
        parecidos = new();
        progresoSostener = 0;
        MostrarEstado("buscando", "Ubique el rostro dentro del óvalo");
    }

    private async Task OnGuardar()
    {
        if (guardando) return;
        guardando = true;
        try
        {
            if (parecidos.Count > 0)
            {
                var ids = string.Join(", ", parecidos.Select(p => p.IdNumero));
                var respuestaSwal = await swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Atención",
                    Text = $"El rostro capturado se parece al de los colaboradores con ID {ids}. ¿Desea guardarlo de todos modos?",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Sí, guardar",
                    CancelButtonText = "No"
                });
                if (!respuestaSwal.IsConfirmed) return;
            }

            var descriptores = await JsRuntime.InvokeAsync<List<string>>("enrollDescriptores");
            if (descriptores.Count == 0) return;

            var plantillas = descriptores.Select(d => new cTemplateFACE
            {
                IDNUMERO = idNumero,
                INDEXID = 0,
                FACETEMPLATE = Encoding.ASCII.GetBytes(d),
            }).ToList();

            EventResponse respuesta = await geoConnect.Post("TemplateFACE", plantillas);
            if (respuesta.Id != "0")
            {
                await swal.FireAsync("Atención", $"Se ha presentado un error al guardar los rostros en la base de datos. Detalle de error: {respuesta.Descripcion}", SweetAlertIcon.Error);
                return;
            }

            await swal.FireAsync("Atención", $"Se guardaron {plantillas.Count} plantillas del rostro.", SweetAlertIcon.Success);
            NavigationManager.NavigateTo(UrlRetorno);
        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al guardar los rostros. Detalle de error: {e.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JsRuntime.InvokeVoidAsync("enrollStop"); } catch { }
        referencia?.Dispose();
    }
}
