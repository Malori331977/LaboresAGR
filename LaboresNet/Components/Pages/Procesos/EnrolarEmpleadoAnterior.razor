@page "/enrolarempleado-anterior/{idNumero}"
@using System.Text
@implements IDisposable 
@using PortalEmpleadoGeotime.Client.Data.DataBaseLocal

<div class="card">
    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />
    <div class="card-body px-2">

        @* ── Cabecera del colaborador ─────────────────────────── *@
        @if (empleado is not null)
        {
            <div style="display:flex;gap:12px;align-items:center;
                        background:#e8f5e9;border-left:4px solid #017F01;
                        border-radius:8px;padding:12px;margin-bottom:12px;">
                <div class="emp-avatar" style="width:48px;height:48px;font-size:1.2rem;flex-shrink:0;">
                    @(string.IsNullOrEmpty(empleado.Nombre) ? "?" : empleado.Nombre.Substring(0,1).ToUpper())
                </div>
                <div>
                    <div style="font-weight:700;font-size:0.95rem;color:#212121;line-height:1.3;">@empleado.Nombre</div>
                    <div style="font-size:0.72rem;color:#888;font-variant-numeric:tabular-nums;">@empleado.IdNumero</div>
                </div>
            </div>
        }

        <div class="ibm-plex-serif-bold">
            <RadzenPanel AllowCollapse="false" class="panel-brand" Style="margin-bottom:0.5rem;">
                <HeaderTemplate>
                    <RadzenIcon Icon="face_retouching_natural" class="me-1" /> Enrolamiento de Rostros
                </HeaderTemplate>
                <ChildContent>
                    @{
                        var faces = new[] {
                            classFace1.Contains("greeninverse"),
                            classFace2.Contains("greeninverse"),
                            classFace3.Contains("greeninverse"),
                            classFace4.Contains("greeninverse"),
                            classFace5.Contains("greeninverse")
                        };
                        var faceCount = faces.Count(f => f);
                    }

                    @* ── Spinner de proceso ──────────────────────────────── *@
                    @if (InProcess)
                    {
                        <SpinnerControl></SpinnerControl>
                    }

                    @* ── Instrucción + contador ──────────────────────────── *@
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 4px 4px;">
                        <span style="font-size:0.8rem;color:#555;">
                            Capture 5 plantillas del rostro
                        </span>
                        <span style="font-size:0.8rem;font-weight:700;color:@(faceCount==5 ? "#017F01" : "#888");">
                            @faceCount / 5
                        </span>
                    </div>

                    @* ── Barra de progreso ───────────────────────────────── *@
                    <div style="height:4px;background:#e0e0e0;border-radius:2px;margin:0 4px 12px;">
                        <div style="height:4px;border-radius:2px;background:#017F01;
                                    width:@(faceCount * 20)%;transition:width 0.3s ease-out;"></div>
                    </div>

                    @* ── Indicadores de rostros (5 círculos) ─────────────── *@
                    <div style="display:flex;gap:8px;justify-content:center;padding-bottom:12px;">
                        @for (int i = 0; i < 5; i++)
                        {
                            var isDone = faces[i];
                            var num    = i + 1;
                            <div style="display:flex;flex-direction:column;align-items:center;gap:3px;">
                                <div style="width:52px;height:52px;border-radius:50%;
                                            background:@(isDone ? "#e8f5e9" : "#fafafa");
                                            border:2px solid @(isDone ? "#017F01" : "#e0e0e0");
                                            display:flex;align-items:center;justify-content:center;
                                            transition:background 0.2s,border-color 0.2s;">
                                    <RadzenIcon Icon="@(isDone ? "check_circle" : "face")"
                                                Style="@($"font-size:1.6rem;color:{(isDone ? "#017F01" : "#ccc")};")"/>
                                </div>
                                <span style="font-size:0.65rem;font-weight:600;color:@(isDone ? "#017F01" : "#bbb");">@num</span>
                            </div>
                        }
                    </div>

                    @* ── Selector de cámara ──────────────────────────────── *@
                    @if (showCameraSelector)
                    {
                        <div class="d-flex align-items-center gap-2 mb-3 px-1">
                            <RadzenIcon Icon="videocam" Style="flex-shrink:0;" />
                            <RadzenDropDown @bind-Value="selectedCameraId"
                                            Data="@cameras"
                                            TextProperty="Label"
                                            ValueProperty="DeviceId"
                                            Style="flex:1; font-size:small;"
                                            Change="@OnCameraChanged" />
                        </div>
                    }

                    @* ── Acciones ────────────────────────────────────────── *@
                    <div style="display:flex;flex-direction:column;gap:8px;padding:0 2px 4px;">
                        <RadzenButton Icon="face_retouching_natural"
                                      Text="Registrar Rostro"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Large"
                                      Style="width:100%;touch-action:manipulation;"
                                      Click="@(() => OnRegistrarRostro())" />
                        <RadzenButton Icon="save"
                                      Text="Guardar Rostros"
                                      ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Large"
                                      Disabled="@(faceCount < 5)"
                                      Style="width:100%;touch-action:manipulation;"
                                      Click="@(() => OnGuardarRostros())" />
                        <RadzenButton Icon="delete_forever"
                                      Text="Cancelar Registro"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Outlined"
                                      Size="ButtonSize.Large"
                                      Style="width:100%;touch-action:manipulation;"
                                      Click="@(() => OnLimpiarRostros())" />
                    </div>

                </ChildContent>
            </RadzenPanel>
        </div>
    </div>
</div>
       




@code {
    [Parameter] public string idNumero { get; set; } = "";


    private cEmpleado empleado = new();
    private bool InProcess = true;

    private string UrlRetorno = "./empleadoextlist";
    private string Titulo = "Registro de Rostros de Colaboradores";
    bool procesoIniciado = false;
    private string classFace1 = "mb-1  text-center h-100 bi-redinverse";
    private string classFace2 = "mb-1  text-center h-100 bi-redinverse";
    private string classFace3 = "mb-1  text-center h-100 bi-redinverse";
    private string classFace4 = "mb-1  text-center h-100 bi-redinverse";
    private string classFace5 = "mb-1  text-center h-100 bi-redinverse";
    private MarcasDBLocal dbLocal = new();

    // Camera selection
    public class CameraInfo
    {
        [System.Text.Json.Serialization.JsonPropertyName("deviceId")]
        public string DeviceId { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("label")]
        public string Label { get; set; } = "";
    }
    private List<CameraInfo> cameras = new();
    private string selectedCameraId = "";
    private bool showCameraSelector = false;

    protected override async Task OnInitializedAsync()
    {
        if (loginState.Empleado is null)
        {
            NavigationManager.NavigateTo("./");
        }

        if (String.IsNullOrEmpty(loginState.Empleado!.IdNumero))
        {
            NavigationManager.NavigateTo("./");
        }

        empleado = await geoConnect.GetEmpleado(idNumero);
        InProcess = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var camList = await JsRuntime.InvokeAsync<List<CameraInfo>>("getCameras");
            if (camList is not null && camList.Count > 1)
            {
                cameras = camList;
                var savedId = await JsRuntime.InvokeAsync<string?>("loadPreferredCamera");
                if (!string.IsNullOrEmpty(savedId) && cameras.Any(c => c.DeviceId == savedId))
                    selectedCameraId = savedId;
                else
                {
                    selectedCameraId = cameras[0].DeviceId;
                    await JsRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
                }
                showCameraSelector = true;
                StateHasChanged();
            }
        }
    }

    private async Task OnCameraChanged(object value)
    {
        selectedCameraId = value?.ToString() ?? "";
        await JsRuntime.InvokeVoidAsync("setPreferredCamera", selectedCameraId);
    }

    private async Task OnIniciarCamara()
    {

    }
    private async Task OnRegistrarRostro()
    {
        if (!procesoIniciado)
        {
            procesoIniciado = true;
        }

        await dialogService.OpenAsync<RegistrarRostroPop>("Registrando...",
             new Dictionary<string, object>()
               {
                    { "OnRegistro", EventCallback.Factory.Create<bool>(this, HideModalRegistroRostro) },
                    { "ProcesoIniciado", procesoIniciado }
               },
             new DialogOptions()
             {
                 Resizable = false,
                 Draggable = false,
                 Width = "340px",
             });
    }

    private async Task HideModalRegistroRostro(bool registrado)
    {
        dialogService.Close(true);

        if (registrado)
        {
            var face1 = await JsRuntime.InvokeAsync<string>("idbGet", "face1");
            var face2 = await JsRuntime.InvokeAsync<string>("idbGet", "face2");
            var face3 = await JsRuntime.InvokeAsync<string>("idbGet", "face3");
            var face4 = await JsRuntime.InvokeAsync<string>("idbGet", "face4");
            var face5 = await JsRuntime.InvokeAsync<string>("idbGet", "face5");

            if (!String.IsNullOrEmpty(face1)) classFace1 = "mb-1  text-center h-100 bi-greeninverse";
            if (!String.IsNullOrEmpty(face2)) classFace2 = "mb-1  text-center h-100 bi-greeninverse";
            if (!String.IsNullOrEmpty(face3)) classFace3 = "mb-1  text-center h-100 bi-greeninverse";
            if (!String.IsNullOrEmpty(face4)) classFace4 = "mb-1  text-center h-100 bi-greeninverse";
            if (!String.IsNullOrEmpty(face5)) classFace5 = "mb-1  text-center h-100 bi-greeninverse";
        }

        StateHasChanged();

    }



    private async Task OnLimpiarRostros()
    {
        InProcess = true;
        StateHasChanged();
        try
        {
            await JsRuntime.InvokeVoidAsync("clearFaces");

            classFace1 = "mb-1  text-center h-100 bi-redinverse";
            classFace2 = "mb-1  text-center h-100 bi-redinverse";
            classFace3 = "mb-1  text-center h-100 bi-redinverse";
            classFace4 = "mb-1  text-center h-100 bi-redinverse";
            classFace5 = "mb-1  text-center h-100 bi-redinverse";

        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al procesar el rostro.  Detalle de error: {(e.InnerException == null ? e.Message : e.InnerException)}", SweetAlertIcon.Error);
        }

        InProcess = false;
        StateHasChanged();
    }


    private async Task OnGuardarRostros()
    {
        try
        {
            List<byte[]> listRostros = new();
            for (int i = 1; i <= 5; i++)
            {
                var face = await JsRuntime.InvokeAsync<string>("idbGet", $"face{i}");

                if (String.IsNullOrEmpty(face))
                {
                    await swal.FireAsync("Atención", "No se ha capturado la cantidad de rostros requeridos.", SweetAlertIcon.Error);
                    InProcess = false;
                    StateHasChanged();
                    return;
                }
                byte[] bytesRostro = Encoding.ASCII.GetBytes(face!);
                listRostros.Add(bytesRostro);
            }

            if (listRostros.Count() > 0)
            {
                await GuardarTemplates(listRostros, empleado);
            }

            NavigationManager.NavigateTo(UrlRetorno);

        }
        catch (Exception e)
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al intentar guardar las plantillas de los Rostros.  Detalle de error: {(e.InnerException == null ? e.Message : e.InnerException)}", SweetAlertIcon.Error);

        }
    }

    public async Task GuardarTemplates(List<byte[]> listRostros, cEmpleado empleado)
    {
        if (empleado is null)
            empleado = await dbLocal.GetEmpleadoAsync(idNumero);

        List<cTemplateFACE> listTemplateFACE = new();
        foreach (var item in listRostros)
        {
            cTemplateFACE empleadoFACE = new cTemplateFACE
                {
                    IDNUMERO = empleado.IdNumero!,
                    INDEXID = 0,
                    FACETEMPLATE = item,
                };
            listTemplateFACE.Add(empleadoFACE);
        }

        EventResponse respuesta = await geoConnect.Post("TemplateFACE", listTemplateFACE);

        if (respuesta.Id != "0")
        {
            await swal.FireAsync("Atención", $"Se ha presentado un error al guardar los Rostros en la base de datos.  Detalle de error: {respuesta.Descripcion}", SweetAlertIcon.Error);
            return;
        }
        await OnLimpiarRostros();
    }

    public void Dispose()
    {
        Task task = new Task(async () =>
        {
            await JsRuntime.InvokeVoidAsync("stopMedia");
        });

        task.Start();

    }
}

