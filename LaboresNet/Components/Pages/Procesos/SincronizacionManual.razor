@page "/sincronizacionmanual"

@layout MainLayout
@using PortalEmpleadoGeotime.Client.Data.DataBaseLocal

<div class="card">
    <PageReturn Titulo="@Titulo" UrlRetorno="@UrlRetorno" />
    <div class="card-body px-2">
        <div class="ibm-plex-serif-bold">
            <RadzenPanel AllowCollapse="false" class="panel-brand" Style="margin-bottom:0.5rem;">
                <HeaderTemplate>
                    <RadzenIcon Icon="sync" class="me-1" /> Sincronización de Datos
                </HeaderTemplate>
                <ChildContent>

                    @if (InProcess)
                    {
                        <div class="text-center py-4">
                            <SpinnerControl></SpinnerControl>
                            <div style="font-size:0.82rem;color:#666;margin-top:8px;">
                                Sincronizando datos, por favor espere…
                            </div>
                        </div>
                    }
                    else
                    {
                        @* ── Última sincronización ───────────────────────────── *@
                        @if (parametro is not null)
                        {
                            <div style="display:flex;align-items:center;gap:10px;
                                        background:#f9f9f9;border:1px solid #deeef6;
                                        border-radius:8px;padding:10px 12px;margin-bottom:14px;">
                                <RadzenIcon Icon="history" Style="font-size:1.4rem;color:#1a76cb;flex-shrink:0;" />
                                <div>
                                    <div style="font-size:0.7rem;color:#888;line-height:1.3;">Última sincronización</div>
                                    <div style="font-weight:600;font-size:0.9rem;color:#212121;">@parametro.UltimaSincronización</div>
                                </div>
                            </div>
                        }

                        @* ── Descripción ─────────────────────────────────────── *@
                        <div style="font-size:0.8rem;color:#555;line-height:1.6;
                                    margin-bottom:16px;padding:0 2px;">
                            Descarga los datos más recientes del servidor (empleados, marcas, nóminas,
                            períodos, centros de costo, plantaciones y labores) y envía los registros
                            pendientes de sincronización.
                        </div>

                        @* ── Acción ──────────────────────────────────────────── *@
                        <EditForm Model="@parametro" OnValidSubmit="SincronizarDatos">
                            <RadzenButton ButtonType="Radzen.ButtonType.Submit"
                                          Icon="sync"
                                          Text="Sincronizar Datos"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Large"
                                          Style="width:100%;touch-action:manipulation;" />
                        </EditForm>
                    }

                </ChildContent>
            </RadzenPanel>
        </div>
    </div>
</div>
							
				
@code {

	private string Titulo = "Sincronización Manual";
	private string UrlRetorno = "./principal";
	private bool InProcess = true;

	private MarcasDBLocal dbLocal = new();
	ParametroSinc parametro = new();

	protected override async void OnInitialized()
	{

		parametro = await dbLocal.GetParametroAsync(1);

		if (parametro is null)
		{
			parametro = new ParametroSinc
			{
				Id = 1,
				UltimaSincronización = DateTime.Now.ToString("yyyyMMdd"),
			};
		}

		InProcess = false;
		StateHasChanged();
	}

	private async Task SincronizarDatos()
	{
		InProcess = true;
		if (await geoConnect.ApiDisponible())
		{
			await SincronizarBases();

		}
		else
		{
			await swal.FireAsync("Atención", $"En este momento no hay comunicación con la base de datos central.", SweetAlertIcon.Warning);
		}
		InProcess=false;
		StateHasChanged();
	}

	private async Task SincronizarBases()
	{
		try
		{
			MarcasDBLocal marcaDBLocal = new();
			var empleadosTask = geoConnect.GetEmpleado();
			var marcasTask = geoConnect.GetMarca(loginState.Empleado.IdNumero!, DateTime.Now.ToString("yyyyMMdd"));
			var phPlanillasTask = geoConnect.GetPhPlanilla();
			var phPeriodosTask = geoConnect.GetPeriodo();
			var marcasPendientesTask = marcaDBLocal.GetMarcaPendiente();
			var ccostosTask = geoConnect.GetCentroCosto();
			var proyectosTask = geoConnect.GetProyecto();
			var estadosTask = geoConnect.GetEstado();
			var faseproyectosTask = geoConnect.GetFaseProyecto();
			var phUsuarioTask = geoConnect.GetPhUsuarioById(loginState.PhLogin!.idusuario!.ToString());
			var phLoginTask = geoConnect.GetPhLogin();
			var distribucionPendienteTask = marcaDBLocal.GetMarcaDistribucionPendienteAsync();
			var templatesFACESTask = geoConnect.GetTemplateFACE();

			var solicitudAuxLaborTask = geoConnect.GetSolicitudAuxLaborByResponsable(loginState.CompaniaSeleccionada, loginState.Empleado.IdNumero!, DateTime.Now.AddDays(-35).ToString("yyyyMMdd"), DateTime.Now.AddDays(1).ToString("yyyyMMdd"));
			var laborAuxiliarTask = marcaDBLocal.GetGeoAgrLaborAuxiliarAsync(loginState.CompaniaSeleccionada, loginState.Empleado.IdNumero!, DateTime.Now.AddDays(-35), DateTime.Now.AddDays(1));
			var itemsLaborAuxiliarTask = marcaDBLocal.GetGeoAgrLaborAuxiliarDetAsync(loginState.CompaniaSeleccionada, loginState.Empleado.IdNumero!, DateTime.Now.AddDays(-35), DateTime.Now.AddDays(1));



			await Task.WhenAll(empleadosTask, marcasTask, phPlanillasTask, phPeriodosTask,
									marcasPendientesTask, ccostosTask, proyectosTask, faseproyectosTask,
									phUsuarioTask, phLoginTask, distribucionPendienteTask, templatesFACESTask,
									laborAuxiliarTask, itemsLaborAuxiliarTask,
									solicitudAuxLaborTask, estadosTask);

			var empleados = await empleadosTask;
			var marcas = await marcasTask;
			var phPlanillas = await phPlanillasTask;
			var phPeriodos = await phPeriodosTask;
			var marcasPendientes = await marcasPendientesTask;
			var ccostos = await ccostosTask;
			var proyectos = await proyectosTask;
			var faseproyectos = await faseproyectosTask;
			var phUsuario = await phUsuarioTask;
			var phLogin = await phLoginTask;
			var marcasDistribucionPendientes = await distribucionPendienteTask;
			var templatesFACES = await templatesFACESTask;
			var estados = await estadosTask;

			var solicitudAuxLabor = await solicitudAuxLaborTask;
			var itemsLaborAuxiliar = await itemsLaborAuxiliarTask;

			List<GeoAgrLaborAuxiliar>? laboresAuxiliares = await laborAuxiliarTask;

			List<cMarcaIn> listMarcas = new();
			if (marcas is not null)
			{
				listMarcas = (from m in marcas
									select new cMarcaIn
								  {
									  idplanilla = m.idplanilla,
									  idnumero = m.idnumero,
									  fecha = m.fecha,
									  hora = m.hora,
									  tipo = m.tipo,
									  idterminal = m.idterminal,
									  estado = 'S',
									  fecha_reg = m.fecha_reg,
									  long_reg = m.long_reg,
									  lat_reg = m.lat_reg,
									  imagen_reg = m.imagen_reg,
									  gps_cell = m.gps_cell,
									  dir_ip = m.dir_ip,
									  host = m.idterminal,
								  })
								.ToList();
			}


			await marcaDBLocal.SaveEmpleadoAsync(empleados);
			await marcaDBLocal.SavePhPlanillaAsync(phPlanillas);
			await marcaDBLocal.SavePhPeriodoAsync(phPeriodos);
			await marcaDBLocal.SaveCentroCostoAsync(ccostos);
			await marcaDBLocal.SaveProyectoAsync(proyectos);
			await marcaDBLocal.SaveFaseProyectoAsync(faseproyectos);
			await marcaDBLocal.SaveEstadoAsync(estados);
			if (listMarcas.Count()>0)
				await marcaDBLocal.SaveMarcaInAsync(listMarcas);
			await marcaDBLocal.SaveTemplateFACEAsync(templatesFACES);

			// Catálogos de labores desde Geotime (todo o nada)
			if (!await PortalEmpleadoGeotime.Client.Data.LaboresCatalogoSync.SincronizarAsync(geoConnect, marcaDBLocal))
			{
				await swal.FireAsync("Atención", "No se pudieron actualizar los catálogos de labores. Se mantienen los datos locales.", SweetAlertIcon.Warning);
			}

			if (solicitudAuxLabor is not null)
			{
				foreach (var solicitud in solicitudAuxLabor)
				{
					List<GeoAgrLaborAuxiliarDet> itemsAuxDetActualizar = new();
					if (laboresAuxiliares.Any(l => l.IdRegistro == solicitud.IDREGISTROAPP))
					{
						var itemsSolicitud = solicitud.cSolicitudAuxLaborDet!;
						foreach (var itemDet in itemsSolicitud)
						{
							var itemsAuxDet = itemsLaborAuxiliar
								.FirstOrDefault(i => i.IdRegistro == solicitud.IDREGISTROAPP
											&& i.Item == itemDet.ITEM
											&& i.IdEmpleadoAsignado == itemDet.IDNUMERO
											&& i.Fecha == itemDet.FECHA);

							if (itemsAuxDet is not null)
							{
								itemsAuxDet.EstadoId = itemDet.ESTADOID;
								itemsAuxDet.CantidadRendimiento = itemDet.CANTIDAD_RENDIMIENTO;
								itemsAuxDet.HorasAprobadas = itemDet.HORAS_APROBADAS;

								itemsAuxDetActualizar.Add(itemsAuxDet);
							}
							
							
						}
					
						if (itemsAuxDetActualizar.Count > 0)
							await marcaDBLocal.SaveGeoAgrLaborAuxiliarDetAsync(itemsAuxDetActualizar);
					}
				}
			}

			// ── Enviar labores pendientes (EstadoId = 0) que no pudieron enviarse por falta de conexión ──
			var laboresPendientes = laboresAuxiliares?.Where(l => l.EstadoId == 0).ToList();
			if (laboresPendientes is not null && laboresPendientes.Count > 0)
			{
				foreach (var labor in laboresPendientes)
				{
					var dets = itemsLaborAuxiliar?.Where(d => d.IdRegistro == labor.IdRegistro).ToList();
					if (dets is null || dets.Count == 0) continue;

					var listaDetalle = dets.Select(d => new cSolicitudAuxLaborDet
					{
						SOLICITUDID          = 0,
						IDNUMERO             = d.IdEmpleadoAsignado!,
						ITEM                 = d.Item,
						BLOQUE               = d.Bloque!,
						FINCA                = d.Finca!,
						LOTE                 = d.Lote!,
						OT                   = d.Ot!,
						LABOR                = d.Labor!,
						RECURSO              = d.Recurso!,
						CANTIDAD_RENDIMIENTO = (decimal)d.CantidadRendimiento!,
						UNIDAD               = d.Unidad!,
						COMPANIA             = labor.Compania!,
						FECHA                = labor.Fecha,
						HORAS_APROBADAS      = 0M,
						ESTADOID             = 1,
					}).ToList();

					var laborGT = new cSolicitudAuxLabor
					{
						ID                    = 0,
						COMPANIA              = labor.Compania!,
						IDRESPONSABLE         = labor.IdEmpleado!,
						FECHA                 = labor.Fecha,
						COMENTARIOS           = labor.Comentarios,
						ESTADOID              = 1,
						cSolicitudAuxLaborDet = listaDetalle,
						FECHAREGISTRO         = DateTime.Now,
						FECHAMODIFICA         = DateTime.Now,
						IDREGISTROAPP         = labor.IdRegistro,
						IDUSUARIOMODIFICA     = loginState.Empleado.IdNumero!,
						IDUSUARIOREGISTRA     = loginState.Empleado.IdNumero!,
					};

					var responseLabor = await geoConnect.Post("SolicitudAuxLabor", new List<cSolicitudAuxLabor>() { laborGT });
					if (responseLabor.Id == "0")
						await marcaDBLocal.SaveGeoAgrLaborAuxiliarEstadoAsync(labor.IdRegistro, labor.Compania!);
				}
			}


			if (phUsuario is not null)
			{
				await marcaDBLocal.SavePhUsuarioAsync(phUsuario, loginState.Empleado.IdNumero!);
			}

			if (phLogin is not null)
			{
				await marcaDBLocal.SavePhLoginAsync(phLogin);
			}

			if (marcasPendientes.Count() > 0)
			{
				var response = await geoConnect.Post("MarcaIn", marcasPendientes);

				if (response.Id != "0")
				{
					await swal.FireAsync("Atención", $"Error al sincronizar marcas pendientes. Detalle de error:{response.Descripcion}", SweetAlertIcon.Info);
				}
				else
				{
					foreach (var marca in marcasPendientes)
					{
						marca.estado = 'S';
						var resp = await marcaDBLocal.SaveMarcaInAsync(marca);

					}
				}
			}

			if (marcasDistribucionPendientes.Count() > 0)
			{
				var marcasDistribucionEnviar = (from m in marcasDistribucionPendientes
												select new cMarcaDistribucionConcepto
												{

													IDREGISTRO = 0,
													COMENTARIO = m.COMENTARIO,
													ESTADO = 'A',
													IDCCOSTO = m.IDCCOSTO,
													PROYECTO = m.PROYECTO,
													FASE = m.FASE,
													CANTIDAD = m.CANTIDAD,
													FECHA = m.FECHA,
													INICIO = m.INICIO,
													FIN = m.FIN,
													IDNUMERO = m.IDNUMERO,
													FECHA_DIST = DateTime.Now,
													IDPLANILLA = m.IDPLANILLA!,
													IDDIST = 0,
													LAT_REG = "",
													LON_REG = "",
												}).ToList();

				var response = await geoConnect.Post("MarcaDistribucionConcepto", marcasDistribucionPendientes);
				if (response.Id != "0")
				{
					await swal.FireAsync("Atención", $"Error al sincronizar marcas de distribución pendientes. Detalle de error:{response.Descripcion}", SweetAlertIcon.Info);
				}
				else
				{
					foreach (var marca in marcasDistribucionPendientes)
					{
						marca.ESTADO = 'S';
						var resp = await marcaDBLocal.SaveMarcaDistribucionConceptoAsync(marca);
					}
				}
			}
			



			if (parametro is null)
				parametro = new ParametroSinc
				{
					Id = 1,
					UltimaSincronización = "",
				};

			parametro.UltimaSincronización = DateTime.Now.ToString("yyyyMMdd");

			var respParam = await marcaDBLocal.SaveParametroAsync(parametro);

			if (respParam == 1)
			{
				await swal.FireAsync("Atención", $"El proceso de sincronización ha finalizado.", SweetAlertIcon.Info);
			}

		}
		catch (Exception e)
		{
			await swal.FireAsync("Error", $"Error al cargar la pagina.  Detalle de error: {e.Message}", SweetAlertIcon.Error);
		}
		StateHasChanged();
	}

	void GoPrincipal() => RedirectTo(UrlRetorno);

	void RedirectTo(string path) => NavigationManager.NavigateTo(path);

}
