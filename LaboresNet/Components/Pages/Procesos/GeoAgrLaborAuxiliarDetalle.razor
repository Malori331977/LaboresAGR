    void OnRender(DataGridRenderEventArgs<EmpleadoExt> args)
    {
        // El orden se gestiona en EmpleadosOrdenados (seleccionados primero, luego por nombre)
    }

    private bool IsSelected(cEmpleado empleado)
    {
        return empleadosSeleccionados.Any(e => e.IdNumero == empleado.IdNumero);
    }

    private void OnSelectionChanged(bool seleccionado, EmpleadoExt empleado)
    {
        if (seleccionado)
        {
            if (!empleadosSeleccionados.Any(e => e.IdNumero == empleado.IdNumero))
                empleadosSeleccionados.Add(empleado);
        }
        else
        {
            empleadosSeleccionados.RemoveAll(e => e.IdNumero == empleado.IdNumero);
        }
        // Re-render para que EmpleadosOrdenados refleje el nuevo estado de selección
        StateHasChanged();
    }

    /// <summary>Seleccionados primero (orden estable), luego el resto por nombre.</summary>
    private IEnumerable<EmpleadoExt> EmpleadosOrdenados =>
        empleados
            .OrderByDescending(e => IsSelected(e))
            .ThenBy(e => e.Nombre);

    /// <summary>True cuando todos los empleados de la lista están seleccionados.</summary>
    private bool TodosSeleccionados =>
        empleados.Any() && empleados.All(e => IsSelected(e));

    /// <summary>Selecciona o deselecciona todos los empleados de la lista.</summary>
    private void OnSeleccionarTodos(bool seleccionar)
    {
        if (seleccionar)
        {
            // Agregar los que aún no estén en la lista de seleccionados
            foreach (var e in empleados)
            {
                if (!empleadosSeleccionados.Any(s => s.IdNumero == e.IdNumero))
                    empleadosSeleccionados.Add(e);
            }
        }
        else
        {
            empleadosSeleccionados.Clear();
        }
        StateHasChanged();
    }
}
