<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>LaboresNet</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>Sistema de Labores</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <DefaultLanguage>ES-ES</DefaultLanguage>
        <AssemblyTitle>LaboresNet</AssemblyTitle>
        <Company>GSITCR</Company>
        <PackageIcon>Icono.png</PackageIcon>
        <AndroidSigningKeyStore>avancesmo-upload.keystore</AndroidSigningKeyStore>
    </PropertyGroup>

    <!-- Contraseñas de firma Android (AndroidSigningKeyPass / AndroidSigningStorePass).
         Viven en un archivo local ignorado por git; ver AndroidSigning.local.props.example. -->
    <Import Project="AndroidSigning.local.props" Condition="Exists('AndroidSigning.local.props')" />

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
      <AndroidKeyStore>True</AndroidKeyStore>
      <AndroidSigningKeyStore>Platforms/Android/AvancesMO.keystore</AndroidSigningKeyStore>
      <AndroidSigningKeyAlias>AvancesMO</AndroidSigningKeyAlias>
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
      <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
      <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
      <AndroidKeyStore>True</AndroidKeyStore>
      <AndroidSigningKeyStore>Platforms/Android/AvancesMO.keystore</AndroidSigningKeyStore>
      <AndroidSigningKeyAlias>AvancesMO</AndroidSigningKeyAlias>
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
      <Optimize>True</Optimize>
      <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
      <AndroidPackageFormat>apk</AndroidPackageFormat>
      <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-maccatalyst|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
      <Optimize>False</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-maccatalyst|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
      <Optimize>False</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
      <ApplicationId>com.gsitcr.geotime.avancesmo</ApplicationId>
      <Optimize>False</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2192FF" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2192FF" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <AndroidResource Remove="Platforms\Android\Resources\drawable\launch_background.xml" />
      <AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Components\Layout\MainLayout.razor~RFa9ab9b.TMP" />
      <None Remove="marcasnet.keystore" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
        <PackageReference Include="CurrieTechnologies.Razor.SweetAlert2" Version="5.6.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
        <PackageReference Include="Radzen.Blazor" Version="11.4.3" />
        <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
        <!-- NU1903: SQLite < 3.50.2 (GHSA-2m69-gcr7-jv3q). Sin fix en NuGet a 2026-06-22; revisar cuando bundle_green > 2.1.11 -->
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" NoWarn="NU1903" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\xlsx\" />
    </ItemGroup>

    <ItemGroup>
      <None Include="wwwroot\img\Icono.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="GeotimeModelsLib">
        <HintPath>Dll\GeotimeModelsLib.dll</HintPath>
      </Reference>
      <Reference Include="JtSegEncrypta">
        <HintPath>D:\Source\Librerias\JtSegEncrypta\JtSegEncrypta\bin\Release\net7.0\JtSegEncrypta.dll</HintPath>
      </Reference>
      <Reference Include="TicoFrutLibs">
        <HintPath>Dll\TicoFrutLibs.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
